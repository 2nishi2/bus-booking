{$SITE_ADDRESS:localhost} {
	tls internal
	encode gzip
 
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
 
	@metrics path /metrics
	respond @metrics 404
 
	reverse_proxy app:8000 {
		health_uri /health
		health_interval 10s
	}
 
	log {
		output stdout
		format json
	}
}
